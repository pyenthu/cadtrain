# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
.svelte-kit/
dist/
build/

# Training data iteration screenshots
training_data/*/images/iter_*.png
training_data/*/images/refine_*.png
training_data/*/images/model_*.png

# Synthetic data generator output (large + ephemeral, regenerated by
# scripts/gen_synthetic.ts). Merged into cache.jsonl only after review.
training_data/synthetic/
training_data/synthetic_cache.jsonl
training_data/cache.jsonl.bak.*
training_data/synthetic_cache.jsonl.bak.*

# Local backup of a corrupted .git directory (e.g., .git.corrupt.bak.YYYYMMDD)
.git.corrupt.bak.*/

# CAD output files
*.step
*.obj
*.stl
*.glb
*.gltf

# Archived legacy work (kept locally, not committed) — root-level only.
# Note: src/routes/archive/ is the in-app reference for the previous
# implementation and IS committed; this rule targets only ./archive at
# the repo root (BOTTOM_SUB_legacy/, HAL_PACKERS/, etc.).
/archive/

# Playwright video staging — transient, renamed to canonical path post-run
static/tests/_video_staging/

# Vendor catalog source PDFs — large + license-uncertain. Keep dir + manifest
# committed (so the indexer + viewer code know what's expected) but not the
# binary itself. Drop PDFs into static/eval/catalog/<vendor>/ locally.
static/eval/catalog/**/*.pdf
static/eval/catalog/**/*.PDF

# KB source documents (pptx/pdf/etc) feeding scripts/kb/*.ts extractors.
# Outputs (static/kb/**/*.json) ARE committed; raw inputs are not — they're
# often vendor catalogs or third-party material with murky licensing.
kb-sources/

# Playwright test artifacts (regenerable). Persisted WEBMs that should
# survive go in static/tests/ and are referenced by manifest.json.
tests/results/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment
.env
.env.*

# Claude Code session artifacts (per-session lock files etc.)
.claude/

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
.svelte-kit/
dist/
build/

# Training data iteration screenshots
training_data/*/images/iter_*.png
training_data/*/images/refine_*.png
training_data/*/images/model_*.png

# Synthetic data generator output (large + ephemeral, regenerated by
# scripts/gen_synthetic.ts). Merged into cache.jsonl only after review.
training_data/synthetic/
training_data/synthetic_cache.jsonl
training_data/cache.jsonl.bak.*
training_data/synthetic_cache.jsonl.bak.*

# Local backup of a corrupted .git directory (e.g., .git.corrupt.bak.YYYYMMDD)
.git.corrupt.bak.*/

# CAD output files
*.step
*.obj
*.stl
*.glb
*.gltf

# Archived legacy work (kept locally, not committed) — root-level only.
# Note: src/routes/archive/ is the in-app reference for the previous
# implementation and IS committed; this rule targets only ./archive at
# the repo root (BOTTOM_SUB_legacy/, HAL_PACKERS/, etc.).
/archive/

# Playwright video staging — transient, renamed to canonical path post-run
static/tests/_video_staging/

# Vendor catalog source PDFs — large + license-uncertain. Keep dir + manifest
# committed (so the indexer + viewer code know what's expected) but not the
# binary itself. Drop PDFs into static/eval/catalog/<vendor>/ locally.
static/eval/catalog/**/*.pdf
static/eval/catalog/**/*.PDF

# KB source documents (pptx/pdf/etc) feeding scripts/kb/*.ts extractors.
# Outputs (static/kb/**/*.json) ARE committed; raw inputs are not — they're
# often vendor catalogs or third-party material with murky licensing.
kb-sources/

# Playwright test artifacts (regenerable). Persisted WEBMs that should
# survive go in static/tests/ and are referenced by manifest.json.
tests/results/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment
.env
.env.*
!.env.local.example

# Local-dev persistent-volume root. Used when no CADTRAIN_VOLUME_ROOT /
# CADTRAIN_VOLUME_REMOTE_URL / Railway-mounted /app_data is configured.
.dev-volume/

# Figure gallery — regenerable extraction artifacts written to the
# volume by scripts/extract_figures.ts. When the project root IS the
# volume root (local-dev with kb-sources/ present) they land in
# ./figures/; on Railway they live under /app_data/figures/. Either
# way they're data, not source — never committed.
/figures/

# Test recordings — Playwright WEBMs + per-task e2e videos, written to
# the volume by scripts/harvest_e2e_videos.ts. Served via /api/volume;
# referenced by /archive/tests + the /plan Gantt popups. Regenerable
# data, not source.
/test-recordings/

# KB tables — structured knowledge-base JSON, on the volume now (was
# static/kb/, committed). Served via /api/volume?path=kb/...; the
# extractor scripts/kb/*.ts write here. Local dev: ./kb/; Railway:
# /app_data/kb/. Re-extract + re-upload rather than commit.
/kb/

# Eval datasets — wells + components recognition fixtures (was
# static/eval/, committed). On the volume now; served via
# /api/volume?path=eval/... to the /archive/tests/{wells,components}
# viewers. Local dev: ./eval/; Railway: /app_data/eval/.
/eval/

# Library — volume-resident component store. Each part is a directory
# under library/<category>/<id>/ (component.ts, picture.png, mesh.glb,
# instructions.md, prompts.json, meta.json). Categories: test / basic /
# parts / assemblies. Runtime CAD data, NOT source — rendered server-side
# via /api/components/geom. The 26 baseline primitives that ARE source
# stay under src/lib/cad/components/. See `src/lib/server/library.ts`.
# Local dev: ./library/ ; Railway: /app_data/library/.
/library/

# Primitives — volume-resident primitive authoring store. Each entry is
# a directory under primitives/<id>/ with source.ts holding both `meta`
# and the geom function. Archived (deleted) primitives live under
# primitives/archive/<id>/. Local dev: ./primitives/ ; Railway:
# /app_data/primitives/. Runtime data, NOT source.
/primitives/

# Claude Code session artifacts (per-session lock files etc.)
.claude/

# Playwright test output (regenerable)
test-results/

# Volume snapshot backup (created by the backup-to-src endpoint) — data, not source
/src/volume_backup/

# Temp/scratch scripts
/scripts/_*tmp*.mjs
.volume-backup/

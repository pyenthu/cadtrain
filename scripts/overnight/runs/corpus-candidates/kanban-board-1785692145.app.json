{
  "app": "kanban-board",
  "title": "Kanban Board",
  "docType": "board",
  "theme": {
    "mode": "light",
    "accent": "#4f46e5"
  },
  "vars": {
    "todo": [
      {
        "title": "Draft spec",
        "owner": "Ada",
        "points": 3
      },
      {
        "title": "Collect requirements",
        "owner": "Lin",
        "points": 2
      }
    ],
    "doing": [
      {
        "title": "Build API",
        "owner": "Sam",
        "points": 5
      },
      {
        "title": "Wire auth",
        "owner": "Ada",
        "points": 3
      }
    ],
    "done": [
      {
        "title": "Set up repo",
        "owner": "Lin",
        "points": 1
      },
      {
        "title": "CI pipeline",
        "owner": "Sam",
        "points": 2
      }
    ]
  },
  "structures": {
    "card": [
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "owner",
        "type": "string"
      },
      {
        "name": "points",
        "type": "number"
      }
    ]
  },
  "panels": [
    {
      "id": "board-title",
      "kind": "heading",
      "props": {
        "text": "Kanban Board",
        "level": 1
      }
    },
    {
      "id": "columns",
      "kind": "tabs",
      "props": {
        "layout": "row"
      },
      "children": [
        {
          "id": "col-todo",
          "kind": "list",
          "props": {
            "title": "To Do",
            "items": "$vars.todo",
            "itemTitle": "title",
            "itemSubtitle": "owner"
          }
        },
        {
          "id": "col-doing",
          "kind": "list",
          "props": {
            "title": "In Progress",
            "items": "$vars.doing",
            "itemTitle": "title",
            "itemSubtitle": "owner"
          }
        },
        {
          "id": "col-done",
          "kind": "list",
          "props": {
            "title": "Done",
            "items": "$vars.done",
            "itemTitle": "title",
            "itemSubtitle": "owner"
          }
        }
      ]
    }
  ]
}

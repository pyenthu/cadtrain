{
  "app": "product-catalog",
  "title": "Product Catalog",
  "docType": "catalog",
  "theme": {
    "mode": "light",
    "accent": "#2563eb"
  },
  "structures": {
    "Product": [
      {
        "name": "sku",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "category",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "stock",
        "type": "number"
      }
    ]
  },
  "vars": {
    "products": [
      {

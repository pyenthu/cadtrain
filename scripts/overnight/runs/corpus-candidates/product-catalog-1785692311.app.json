  "panels": [
    {
      "id": "header",
      "kind": "heading",
      "props": {
        "text": "Product Catalog",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Search and browse the full product list."
      }
    },
    {
      "id": "summary",
      "kind": "statgrid",
      "children": [
        {
          "id": "stat-skus",
          "kind": "stat",
          "props": {
            "label": "SKUs",
            "value": 6
          }
        },
        {
          "id": "stat-categories",
          "kind": "stat",
          "props": {
            "label": "Categories",
            "value": 3
          }
        },
        {
          "id": "stat-units",
          "kind": "stat",
          "props": {
            "label": "Units in Stock",
            "value": 195
          }
        }
      ]
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "title": "Products",
        "rows": "$vars.products",
        "search": true,
        "sortable": true,
        "pageSize": 10,
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Product"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "Stock",
            "format": "number"
          }
        ]
      }
    }
  ]
}

          "kind": "stat",
          "props": {
            "label": "Categories",
            "value": 3
          }
        },
        {
          "id": "stat-units",
          "kind": "stat",
          "props": {
            "label": "Units In Stock",
            "value": 350
          }
        }
      ]
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "data": "$products",
        "searchable": true,
        "sortable": true,
        "pageSize": 10,
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Product"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "Stock",
            "format": "number"
          }
        ]
      }
    }
  ]
}

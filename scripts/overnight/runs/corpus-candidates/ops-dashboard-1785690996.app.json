      {
        "day": "Wed",
        "runs": 51
      },
      {
        "day": "Thu",
        "runs": 67
      },
      {
        "day": "Fri",
        "runs": 73
      },
      {
        "day": "Sat",
        "runs": 39
      },
      {
        "day": "Sun",
        "runs": 31
      }
    ],
    "jobs": [
      {
        "job": "bake-queue",
        "status": "OK",
        "duration": 128,

  "structures": {
    "jobs": [
      {
        "name": "job",
        "type": "string"
      },
      {
        "name": "status",
        "type": "string"
      },
      {
        "name": "duration",
        "type": "number"
      },
      {
        "name": "owner",
        "type": "string"
      }
    ]
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Operations Dashboard",
        "level": 1
      }
    },
    {
      "id": "subtitle",
      "kind": "text",
      "props": {
        "text": "Live pipeline health for the last 7 days."
      }
    },
    {
      "id": "kpis",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "kpi-runs",
          "kind": "stat",
          "props": {
            "label": "Total Runs",
            "value": 361,
            "delta": "+12%",
            "trend": "up"
          }
        },
        {
          "id": "kpi-uptime",
          "kind": "stat",
          "props": {
            "label": "Uptime",
            "value": "99.4%",
            "delta": "+0.3%",
            "trend": "up"
          }
        },
        {
          "id": "kpi-failures",
          "kind": "stat",
          "props": {
            "label": "Failures",
            "value": 7,
            "delta": "-3",
            "trend": "down"
          }
        }
      ]
    },
    {
      "id": "trend",
      "kind": "chart",
      "props": {
        "type": "line",
        "title": "Runs per Day",
        "x": "day",
        "y": "runs",
        "height": 260
      },
      "source": {
        "verb": "vars.get",
        "args": {
          "name": "throughput"
        }
      }
    },
    {
      "id": "jobs-table",
      "kind": "datatable",
      "props": {
        "title": "Recent Jobs",
        "columns": [
          {
            "key": "job",
            "label": "Job"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "duration",
            "label": "Duration (s)",
            "align": "right"
          },
          {
            "key": "owner",
            "label": "Owner"
          }
        ],
        "sortable": true,
        "searchable": true,
        "pageSize": 10
      },
      "source": {
        "verb": "vars.get",
        "args": {
          "name": "jobs"
        }
      }
    }
  ]
}

  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Operations Dashboard",
        "level": 1
      }
    },
    {
      "id": "subtitle",
      "kind": "text",
      "props": {
        "text": "Pipeline health and throughput for the last six months."
      }
    },
    {
      "id": "kpis",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "kpi-runs",
          "kind": "stat",
          "props": {
            "label": "Total Runs",
            "value": "3,430",
            "delta": "+8.5%",
            "trend": "up"
          }
        },
        {
          "id": "kpi-p95",
          "kind": "stat",
          "props": {
            "label": "p95 Latency",
            "value": "842 ms",
            "delta": "-12%",
            "trend": "down"
          }
        },
        {
          "id": "kpi-uptime",
          "kind": "stat",
          "props": {
            "label": "Uptime",
            "value": "99.4%",
            "delta": "+0.2%",
            "trend": "up"
          }
        }
      ]
    },
    {
      "id": "throughput-chart",
      "kind": "chart",
      "props": {
        "type": "line",
        "x": "month",
        "y": "runs",
        "title": "Monthly Runs"
      },
      "source": {
        "verb": "var.read",
        "args": {
          "name": "throughput"
        }
      }
    },
    {
      "id": "jobs-table",
      "kind": "datatable",
      "props": {
        "title": "Jobs",
        "columns": [
          "job",
          "owner",
          "status",
          "runs",
          "p95_ms"
        ],
        "sortable": true,
        "searchable": true,
        "pageSize": 10
      },
      "source": {
        "verb": "var.read",
        "args": {
          "name": "jobs"
        }
      }
    }
  ]
}

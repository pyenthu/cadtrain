{
  "app": "survey-form",
  "title": "Customer Survey",
  "docType": "form",
  "theme": {
    "mode": "light",
    "accent": "#2563eb"
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Customer Survey",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Tell us about your experience. It takes about two minutes."
      }
    },
    {
      "id": "survey",
      "kind": "form",
      "props": {
        "submitLabel": "Submit",
        "fields": [
          {
            "name": "name",
            "label": "Your name",
            "type": "text",
            "required": true
          },
          {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true
          },
          {
            "name": "role",
            "label": "Role",
            "type": "select",
            "options": [
              "Engineer",
              "Operations",
              "Management",
              "Other"
            ]
          },
          {
            "name": "satisfaction",
            "label": "How satisfied are you overall?",
            "type": "select",
            "required": true,
            "options": [
              "Very satisfied",
              "Satisfied",
              "Neutral",
              "Dissatisfied",
              "Very dissatisfied"
            ]
          },
          {
            "name": "recommend",
            "label": "How likely are you to recommend us? (0-10)",
            "type": "number",
            "min": 0,
            "max": 10
          },
          {
            "name": "improvements",
            "label": "What should we improve?",
            "type": "textarea"
          },
          {
            "name": "followup",
            "label": "May we contact you about your answers?",
            "type": "checkbox"
          }
        ]
      }
    }
  ]
}

  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Product Catalog",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Search and browse the full product line."
      }
    },
    {
      "id": "summary",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "stat-skus",
          "kind": "stat",
          "props": {
            "label": "SKUs",
            "value": 6
          }
        },
        {
          "id": "stat-categories",
          "kind": "stat",
          "props": {
            "label": "Categories",
            "value": 2
          }
        },
        {
          "id": "stat-stock",
          "kind": "stat",
          "props": {
            "label": "Units In Stock",
            "value": 116
          }
        }
      ]
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "data": "$vars.products",
        "search": true,
        "sortable": true,
        "pageSize": 10,
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Product"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "Stock",
            "format": "number"
          }
        ]
      }
    }
  ]
}

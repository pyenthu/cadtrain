{
  "app": "product-catalog",
  "title": "Product Catalog",
  "docType": "catalog",
  "theme": {
    "mode": "light",
    "accent": "#2563eb"
  },
  "structures": {
    "Product": [
      {
        "name": "sku",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "category",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "stock",
        "type": "number"
      }
    ]
  },
  "vars": {
    "products": [
      {
        "sku": "PC-1001",
        "name": "Drill Collar 6-1/2\"",
        "category": "Drilling",
        "price": 4200,
        "stock": 12
      },
      {
        "sku": "PC-1002",
        "name": "Float Sub 4-1/2\"",
        "category": "Drilling",
        "price": 1850,
        "stock": 30
      },
      {
        "sku": "PC-2001",
        "name": "Packer 7\" Retrievable",
        "category": "Completions",
        "price": 9800,
        "stock": 6
      },
      {
        "sku": "PC-2002",
        "name": "Sliding Sleeve 5-1/2\"",
        "category": "Completions",
        "price": 5400,
        "stock": 9
      },
      {
        "sku": "PC-3001",
        "name": "Landing Nipple 3-1/2\"",
        "category": "Completions",
        "price": 1200,
        "stock": 48
      }
    ]
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Product Catalog",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Search and sort the full product list."
      }
    },
    {
      "id": "summary",
      "kind": "statgrid",
      "children": [
        {
          "id": "stat-skus",
          "kind": "stat",
          "props": {
            "label": "SKUs",
            "value": 5
          }
        },
        {
          "id": "stat-stock",
          "kind": "stat",
          "props": {
            "label": "Units in Stock",
            "value": 105
          }
        },
        {
          "id": "stat-value",
          "kind": "stat",
          "props": {
            "label": "Avg Price",
            "value": "$4,490"
          }
        }
      ]
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "data": "$vars.products",
        "search": true,
        "sortable": true,
        "pageSize": 10,
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Product"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "Stock",
            "format": "number"
          }
        ]
      }
    }
  ]
}

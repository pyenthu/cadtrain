      },
      {
        "label": "Open Alerts",
        "value": "14",
        "delta": "-3"
      }
    ],
    "throughput": [
      {
        "month": "Mar",
        "bbl": 8200
      },
      {
        "month": "Apr",
        "bbl": 8900
      },
      {
        "month": "May",
        "bbl": 9400
      },

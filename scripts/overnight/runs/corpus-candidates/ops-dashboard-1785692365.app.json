  },
  "structures": {
    "jobs": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "rig",
        "type": "string"
      },
      {
        "name": "status",
        "type": "string"
      },
      {
        "name": "hours",
        "type": "number"
      }
    ]
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Operations Dashboard",
        "level": 1
      }
    },
    {
      "id": "subtitle",
      "kind": "text",
      "props": {
        "text": "Live field operations overview"
      }
    },
    {
      "id": "kpi-row",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "kpi-wells",
          "kind": "stat",
          "props": {
            "label": "Active Wells",
            "value": "128",
            "delta": "+6"
          }
        },
        {
          "id": "kpi-uptime",
          "kind": "stat",
          "props": {
            "label": "Uptime",
            "value": "99.2%",
            "delta": "+0.3"
          }
        },
        {
          "id": "kpi-alerts",
          "kind": "stat",
          "props": {
            "label": "Open Alerts",
            "value": "14",
            "delta": "-3"
          }
        }
      ]
    },
    {
      "id": "throughput-chart",
      "kind": "chart",
      "props": {
        "type": "line",
        "title": "Monthly Throughput (bbl)",
        "x": "month",
        "y": "bbl",
        "data": "$vars.throughput"
      }
    },
    {
      "id": "jobs-table",
      "kind": "datatable",
      "props": {
        "title": "Active Jobs",
        "data": "$vars.jobs",
        "columns": [
          {
            "key": "id",
            "label": "Job"
          },
          {
            "key": "rig",
            "label": "Rig"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "hours",
            "label": "Hours",
            "align": "right"
          }
        ],
        "sortable": true,
        "search": true,
        "pageSize": 10
      }
    }
  ]
}

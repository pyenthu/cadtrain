{
  "app": "customer-survey",
  "title": "Customer Survey",
  "docType": "form",
  "theme": {
    "mode": "light",
    "accent": "#2563eb"
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Customer Survey",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Help us improve — this takes about two minutes."
      }
    },
    {
      "id": "survey",
      "kind": "form",
      "props": {
        "submitLabel": "Submit Survey",
        "fields": [
          {
            "name": "name",
            "label": "Your Name",
            "type": "text",
            "required": true
          },
          {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true
          },
          {
            "name": "role",
            "label": "Role",
            "type": "select",
            "options": [
              "Engineer",
              "Manager",
              "Operator",
              "Other"
            ]
          },
          {
            "name": "satisfaction",
            "label": "How satisfied are you overall?",
            "type": "select",
            "required": true,
            "options": [
              "Very satisfied",
              "Satisfied",
              "Neutral",
              "Dissatisfied",
              "Very dissatisfied"
            ]
          },
          {
            "name": "frequency",
            "label": "How often do you use the product?",
            "type": "select",
            "options": [
              "Daily",
              "Weekly",
              "Monthly",
              "Rarely"
            ]
          },
          {
            "name": "recommend",
            "label": "How likely are you to recommend us? (0-10)",
            "type": "number",
            "min": 0,
            "max": 10
          },
          {
            "name": "comments",
            "label": "What could we do better?",
            "type": "textarea"
          }
        ]
      }
    }
  ]
}

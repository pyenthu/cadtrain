{
  "app": "customer-survey",
  "title": "Customer Survey",
  "docType": "form",
  "theme": {
    "mode": "light",
    "accent": "#2563eb"
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Customer Survey",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Help us improve — this takes about two minutes."
      }
    },
    {
      "id": "survey-form",
      "kind": "form",
      "props": {
        "submitLabel": "Submit",
        "fields": [
          {
            "name": "name",
            "label": "Your name",
            "type": "text",
            "required": true
          },
          {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true
          },
          {
            "name": "rating",
            "label": "How would you rate your experience?",
            "type": "select",
            "options": [
              "Excellent",
              "Good",
              "Average",
              "Poor"
            ],
            "required": true
          },
          {
            "name": "used_since",
            "label": "How long have you used the product?",
            "type": "select",
            "options": [
              "Less than a month",
              "1-6 months",
              "6-12 months",
              "Over a year"
            ]
          },
          {
            "name": "recommend",
            "label": "Would you recommend us?",
            "type": "select",
            "options": [
              "Yes",
              "Maybe",
              "No"
            ],
            "required": true
          },
          {
            "name": "comments",
            "label": "Anything else you'd like to share?",
            "type": "textarea"
          }
        ]
      }
    }
  ]
}

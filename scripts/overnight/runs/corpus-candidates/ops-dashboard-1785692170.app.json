  },
  "structures": {
    "jobs": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "rig",
        "type": "string"
      },
      {
        "name": "status",
        "type": "string"
      },
      {
        "name": "progress",
        "type": "number"
      }
    ]
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Operations Dashboard",
        "level": 1
      }
    },
    {
      "id": "subtitle",
      "kind": "text",
      "props": {
        "text": "Live field operations overview — last 7 days."
      }
    },
    {
      "id": "kpi-row",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "kpi-wells",
          "kind": "stat",
          "props": {
            "label": "Active Wells",
            "value": 128,
            "delta": "+4",
            "trend": "up"
          }
        },
        {
          "id": "kpi-uptime",
          "kind": "stat",
          "props": {
            "label": "Uptime",
            "value": "99.2%",
            "delta": "+0.3",
            "trend": "up"
          }
        },
        {
          "id": "kpi-alerts",
          "kind": "stat",
          "props": {
            "label": "Open Alerts",
            "value": 7,
            "delta": "-2",
            "trend": "down"
          }
        }
      ]
    },
    {
      "id": "throughput-chart",
      "kind": "chart",
      "props": {
        "type": "line",
        "title": "Daily Throughput (bbl)",
        "x": "day",
        "y": "bbl",
        "data": "$vars.throughput"
      }
    },
    {
      "id": "jobs-table",
      "kind": "datatable",
      "props": {
        "title": "Active Jobs",
        "data": "$vars.jobs",
        "columns": [
          {
            "key": "id",
            "label": "Job"
          },
          {
            "key": "rig",
            "label": "Rig"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "progress",
            "label": "Progress %"
          }
        ],
        "sortable": true,
        "searchable": true,
        "pageSize": 10
      }
    }
  ]
}

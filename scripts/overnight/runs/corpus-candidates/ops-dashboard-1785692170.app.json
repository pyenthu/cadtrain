        "delta": "+0.3"
      },
      {
        "label": "Open Alerts",
        "value": 7,
        "delta": "-2"
      }
    ],
    "throughput": [
      {
        "day": "Mon",
        "bbl": 1420
      },
      {
        "day": "Tue",
        "bbl": 1580
      },
      {
        "day": "Wed",
        "bbl": 1490
      },
      {
        "day": "Thu",
        "bbl": 1735
      },
      {

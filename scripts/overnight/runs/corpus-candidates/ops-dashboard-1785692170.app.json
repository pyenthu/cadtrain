        "bbl": 1810
      },
      {
        "day": "Sat",
        "bbl": 1655
      },
      {
        "day": "Sun",
        "bbl": 1720
      }
    ],
    "jobs": [
      {
        "id": "JOB-1041",
        "rig": "Rig 7",
        "status": "Running",
        "progress": 72
      },
      {
        "id": "JOB-1042",

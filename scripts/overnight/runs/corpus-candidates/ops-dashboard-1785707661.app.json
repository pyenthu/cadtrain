      },
      {
        "label": "Open Alerts",
        "value": 7,
        "delta": "-2"
      }
    ],
    "throughput": [
      {
        "month": "Jan",
        "bbl": 1420
      },
      {
        "month": "Feb",
        "bbl": 1580
      },
      {
        "month": "Mar",
        "bbl": 1490
      },
      {

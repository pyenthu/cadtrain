        "bbl": 1810
      },
      {
        "month": "Jun",
        "bbl": 1902
      }
    ],
    "jobs": [
      {
        "id": "J-1041",
        "site": "Permian A",
        "status": "Running",
        "hours": 18
      },
      {
        "id": "J-1042",
        "site": "Eagle Ford B",
        "status": "Queued",

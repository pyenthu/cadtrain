      }
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "title": "Products",
        "rows": "$products",
        "search": true,
        "sortable": true,
        "pageSize": 10,
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Name"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "align": "right",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "Stock",
            "align": "right"
          }
        ]
      }
    }
  ]
}

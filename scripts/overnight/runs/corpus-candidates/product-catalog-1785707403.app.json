        "type": "number"
      },
      {
        "name": "status",
        "type": "string"
      }
    ]
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Product Catalog",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Search and browse the full product list."
      }
    },
    {
      "id": "summary",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "stat-skus",
          "kind": "stat",
          "props": {
            "label": "SKUs",
            "value": 8
          }
        },
        {
          "id": "stat-categories",
          "kind": "stat",
          "props": {
            "label": "Categories",
            "value": 4
          }
        },
        {
          "id": "stat-units",
          "kind": "stat",
          "props": {
            "label": "Units in Stock",
            "value": 3163
          }
        }
      ]
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "title": "Products",
        "rows": "$vars.products",
        "search": true,
        "searchPlaceholder": "Search products…",
        "sortable": true,
        "pageSize": 10,
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Product"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "align": "right",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "Stock",
            "align": "right"
          },
          {
            "key": "status",
            "label": "Status"
          }
        ]
      }
    }
  ]
}

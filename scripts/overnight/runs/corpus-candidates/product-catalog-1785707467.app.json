  "structures": {
    "product": [
      {
        "name": "sku",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "category",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "stock",
        "type": "number"
      }
    ]
  },
  "vars": {
    "products": [
      {

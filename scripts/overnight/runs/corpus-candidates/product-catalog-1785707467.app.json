    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Search and browse the full product list."
      }
    },
    {
      "id": "catalog-table",
      "kind": "datatable",
      "props": {
        "rows": "$vars.products",
        "columns": [
          {
            "key": "sku",
            "label": "SKU"
          },
          {
            "key": "name",
            "label": "Product"
          },
          {
            "key": "category",
            "label": "Category"
          },
          {
            "key": "price",
            "label": "Price",
            "format": "currency"
          },
          {
            "key": "stock",
            "label": "In Stock",
            "format": "number"
          }
        ],
        "search": true,
        "sortable": true,
        "pageSize": 10
      }
    }
  ]

      },
      {
        "sku": "PC-2001",
        "name": "Gadget Pro",
        "category": "Gadgets",
        "price": 149.99,
        "stock": 12
      },
      {
        "sku": "PC-2002",
        "name": "Gadget Mini",
        "category": "Gadgets",

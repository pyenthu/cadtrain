{
  "app": "ops-dashboard",
  "title": "Operations Dashboard",
  "docType": "dashboard",
  "theme": {
    "mode": "dark",
    "accent": "#4f8ef7"
  },
  "vars": {
    "kpis": [
      {
        "label": "Active Wells",
        "value": "128",
        "delta": "+4"
      },
      {
        "label": "Uptime",
        "value": "99.2%",
        "delta": "+0.3"
      },
      {
        "label": "Open Alerts",
        "value": "7",
        "delta": "-2"
      }
    ],
    "throughput": [
      {
        "month": "Jan",
        "bbl": 820
      },
      {
        "month": "Feb",
        "bbl": 910
      },
      {
        "month": "Mar",
        "bbl": 870
      },
      {
        "month": "Apr",
        "bbl": 1040
      },
      {
        "month": "May",
        "bbl": 1120
      },
      {
        "month": "Jun",
        "bbl": 1180
      }
    ],
    "jobs": [
      {
        "id": "JOB-101",
        "rig": "Rig A",
        "status": "Running",
        "hours": 42
      },
      {
        "id": "JOB-102",
        "rig": "Rig B",
        "status": "Queued",
        "hours": 0
      },
      {
        "id": "JOB-103",
        "rig": "Rig C",
        "status": "Complete",
        "hours": 118
      },
      {
        "id": "JOB-104",
        "rig": "Rig A",
        "status": "Paused",
        "hours": 26
      }
    ]
  },
  "structures": {
    "jobs": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "rig",
        "type": "string"
      },
      {
        "name": "status",
        "type": "string"
      },
      {
        "name": "hours",
        "type": "number"
      }
    ]
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Operations Dashboard",
        "level": 1
      }
    },
    {
      "id": "subtitle",
      "kind": "text",
      "props": {
        "text": "Live rig and production overview."
      }
    },
    {
      "id": "kpi-row",
      "kind": "statgrid",
      "props": {
        "columns": 3
      },
      "children": [
        {
          "id": "kpi-wells",
          "kind": "stat",
          "props": {
            "label": "Active Wells",
            "value": "128",
            "delta": "+4"
          }
        },
        {
          "id": "kpi-uptime",
          "kind": "stat",
          "props": {
            "label": "Uptime",
            "value": "99.2%",
            "delta": "+0.3"
          }
        },
        {
          "id": "kpi-alerts",
          "kind": "stat",
          "props": {
            "label": "Open Alerts",
            "value": "7",
            "delta": "-2"
          }
        }
      ]
    },
    {
      "id": "throughput-chart",
      "kind": "chart",
      "props": {
        "type": "line",
        "title": "Monthly Throughput (bbl)",
        "x": "month",
        "y": "bbl",
        "data": "$vars.throughput"
      }
    },
    {
      "id": "jobs-table",
      "kind": "datatable",
      "props": {
        "title": "Active Jobs",
        "data": "$vars.jobs",
        "columns": [
          {
            "key": "id",
            "label": "Job"
          },
          {
            "key": "rig",
            "label": "Rig"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "hours",
            "label": "Hours"
          }
        ],
        "sortable": true,
        "searchable": true,
        "pageSize": 10
      }
    }
  ]
}

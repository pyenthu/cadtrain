{
  "app": "customer-survey",
  "title": "Customer Survey",
  "docType": "form",
  "theme": {
    "mode": "light",
    "accent": "#3b82f6"
  },
  "panels": [
    {
      "id": "title",
      "kind": "heading",
      "props": {
        "text": "Customer Survey",
        "level": 1
      }
    },
    {
      "id": "intro",
      "kind": "text",
      "props": {
        "text": "Tell us about your experience. It takes about two minutes."
      }
    },
    {
      "id": "survey",
      "kind": "form",
      "props": {
        "submitLabel": "Submit",
        "fields": [
          {
            "name": "name",
            "label": "Name",
            "type": "text",
            "required": true
          },
          {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true
          },
          {
            "name": "rating",
            "label": "How would you rate us?",
            "type": "select",
            "options": [
              "Excellent",
              "Good",
              "Average",
              "Poor"
            ],
            "required": true
          },
          {
            "name": "usage",
            "label": "How often do you use the product?",
            "type": "select",
            "options": [
              "Daily",
              "Weekly",
              "Monthly",
              "Rarely"
            ]
          },
          {
            "name": "recommend",
            "label": "Would you recommend us?",
            "type": "select",
            "options": [
              "Yes",
              "Maybe",
              "No"
            ]
          },
          {
            "name": "comments",
            "label": "Additional comments",
            "type": "textarea"
          }
        ]
      }
    }
  ]
}

    "@types/bun": "latest",
    "@vitest/expect": "^4.1.4",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@gltf-transform/core": "^4.3.0",
    "@threlte/core": "^8.5.9",
    "@threlte/extras": "^9.14.5",

    "codemirror": "^6.0.2",
    "manifold-3d": "^3.4.1",
    "marked": "^18.0.3",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "svelte": "^5.55.3",
    "svelte-tweakpane-ui": "^1.5.16",

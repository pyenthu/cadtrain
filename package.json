{
  "name": "manifold",
  "main": "build/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3333",
    "build": "vite build",
    "preview": "vite preview",
    "start": "HOST=0.0.0.0 PORT=${PORT:-3333} node build",
    "seed": "bun run scripts/seed_cache.ts",
    "extract:figures": "bun run scripts/extract_figures.ts",
    "extract:generate": "bun run scripts/overnight_extract.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "deadcode": "knip",
    "deadcode:exports": "knip --include exports,types",
    "test:e2e": "playwright test",
    "test:e2e:headed": "PWHEAD=1 playwright test",
    "test:graph": "playwright test tests/e2e/graph-editor.spec.ts",
    "test:graph:headed": "PWHEAD=1 playwright test tests/e2e/graph-editor.spec.ts",
    "test:volume": "playwright test tests/e2e/volume.spec.ts",
    "test:e2e:report": "playwright show-report tests/results/playwright-report",
    "record:task": "bun run scripts/harvest_e2e_videos.ts --task"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4",
    "@types/bun": "latest",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "knip": "^6.17.1",
    "tailwindcss": "^4",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@gltf-transform/core": "^4.3.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polydera/trueform": "0.9.8",
    "@threlte/core": "^8.5.9",
    "@threlte/extras": "^9.14.5",
    "@xyflow/svelte": "^1.6.1",
    "acorn": "^8.16.0",
    "esbuild": "^0.25.0",
    "makerjs": "^0.19.2",
    "manifold-3d": "^3.4.1",
    "marked": "^18.0.3",
    "mathjs": "^15.2.0",
    "mermaid": "^11.15.0",
    "playwright": "^1.59.1",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "sharp": "^0.34.5",
    "svelte": "^5.55.3",
    "three": "^0.183.2",
    "three-svg-renderer": "^1.0.4"
  }
}

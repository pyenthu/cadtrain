# Local-dev env (`.env.local`) — copy this to `.env.local` and fill in.
# Loaded automatically by SvelteKit alongside `.env` in dev. Gitignored.

# ─── Anthropic ────────────────────────────────────────────────────────────
# Required for /api/identify, /api/refine, /api/components/refine in API mode.
# Also set on Railway as a service variable; locally goes here.
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Persistent data volume ───────────────────────────────────────────────
# When all three of these are blank, local dev reads/writes a self-contained
# folder under ./.dev-volume/ (auto-created on first call, gitignored).
# Set them to point your local dev instance at the LIVE production volume
# instead — every /api/volume + /api/kb/source-pdf call proxies to prod.

# Public URL of your Railway deployment (no trailing slash).
# CADTRAIN_VOLUME_REMOTE_URL=https://your-service.up.railway.app

# Shared secret. Generate with `openssl rand -hex 32` and set the SAME
# value as a Railway service variable on the production service. Without
# the match, the prod /api/volume endpoint returns 401.
# CADTRAIN_VOLUME_TOKEN=

# Optional: pin a different local-dev volume root. Useful for swapping
# between test fixtures. When set, takes precedence over CADTRAIN_VOLUME_REMOTE_URL.
# CADTRAIN_VOLUME_ROOT=./.dev-volume

# ─── Identify / Wells backends ────────────────────────────────────────────
# Defaults: api / claude-sonnet-4-20250514 / claude-opus-4-7
# IDENTIFY_BACKEND=api
# IDENTIFY_MODEL=claude-sonnet-4-20250514
# WELLS_BACKEND=api
# WELLS_MODEL=claude-opus-4-7

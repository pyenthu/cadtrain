{
  "$schema": "./vocabulary.schema.json",
  "version": "0.3.0",
  "notes": [
    "K.68 Phase 1 draft, 2026-06-05.",
    "Each entry is a TERM in the compositional grammar.",
    "A rule compiles deterministically to AsmSource via rule-translator.ts (Phase 2).",
    "Synonyms are aliases the RAG retrieval treats as the same term."
  ],
  "terms": {
    "shaft": {
      "kind": "rev",
      "definition": "Cylindrical profile, half-section (r, len). The atomic primitive — every other rotational shape extends this.",
      "synonyms": [
        "cylinder",
        "solid rod",
        "round bar"
      ],
      "params": {
        "r": {
          "default": 1,
          "min": 0.05,
          "max": 10,
          "step": 0.05,
          "unit": "in"
        },
        "len": {
          "default": 3,
          "min": 0.1,
          "max": 50,
          "step": 0.1,
          "unit": "in"
        },
        "segments": {
          "default": 64,
          "min": 8,
          "max": 256,
          "step": 1
        }
      },
      "rule": {
        "kind": "primitive",
        "template": "cylinder",
        "engine": "r_revolve"
      },
      "exemplar": "dt_shaft",
      "expects_bake": {
        "verts": 258,
        "z_extent": 3,
        "outer_r": 1
      }
    },
    "tube": {
      "kind": "asm",
      "definition": "Open tube — a smaller shaft subtracted from a larger shaft. Outer radius = od/2; inner radius = od/2 - wall.",
      "synonyms": [
        "pipe",
        "hollow shaft",
        "open cylinder"
      ],
      "params": {
        "od": {
          "default": 4.5,
          "min": 0.1,
          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "wall": {
          "default": 0.5,
          "min": 0.05,
          "max": 5,
          "step": 0.05,
          "unit": "in"
        },
        "length": {
          "default": 3,
          "min": 0.1,
          "max": 50,
          "step": 0.1,
          "unit": "in"
        }
      },
      "rule": {
        "kind": "compose",
        "imports": [
          {
            "alias": "A",
            "term": "shaft"
          },
          {
            "alias": "B",
            "term": "shaft"
          }
        ],
        "composition": {
          "type": "method",
          "op": "subtract",
          "obj": {
            "type": "call",
            "fn": "A",
            "args": {
              "segments": 64,
              "r": "p.od / 2",
              "len": "p.length"
            }
          },
          "arg": {
            "type": "call",
            "fn": "B",
            "args": {
              "segments": 64,
              "r": "p.od/2 - p.wall",
              "len": "p.length"
            }
          }
        }
      },
      "exemplar": "dt_tube",
      "expects_bake": {
        "verts": 1536,
        "z_extent": 3,
        "outer_r": 2.25,
        "min_r": 1.75
      }
    },
    "collar_flat": {

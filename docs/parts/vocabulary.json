    "pin": {
      "kind": "rev",
      "definition": "Male tapered connection — shaft body + upset joint shoulder + tapered nose. Used as the male end of a tool joint.",
      "synonyms": [
        "male connection",
        "tapered pin",
        "drill-pipe pin"
      ],
      "extends": "shaft",
      "thread_spec": {
        "_note": "Inline for v0.1. Will move to docs/parts/thread_specs.json when that KB exists. Translator reads `name` first, falls back to the raw fields below.",
        "name": "NC50",
        "pitch": 0.25,
        "taper_in_per_ft": 2,
        "thread_starts": 1,
        "thread_form": "V"
      },
      "params": {
        "pipeOD": {
          "default": 4,
          "min": 0.5,
          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "jointOD": {
          "default": 5.25,
          "min": 0.5,
          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "wall": {
          "default": 0.5,
          "min": 0.05,
          "max": 5,
          "step": 0.05,
          "unit": "in"
        },
        "pipeLen": {
          "default": 3,
          "min": 0.1,
          "max": 50,
          "step": 0.1,
          "unit": "in"
        },
        "jointLen": {
          "default": 6,
          "min": 0.1,
          "max": 20,
          "step": 0.1,
          "unit": "in"
        },
        "jtUpset": {
          "default": 0.25,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "in"
        },
        "jointTaper": {
          "default": 45,
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "deg"
        },
        "threadTaper": {
          "default": 5,
          "min": 0,
          "max": 30,
          "step": 0.5,
          "unit": "deg"
        },
        "thdLen": {
          "default": 4,
          "min": 0.1,
          "max": 16,
          "step": 0.1,
          "unit": "in",
          "_note": "Thread length. Joint upset (flat collar) length is then `jointLen - thdLen`."
        },
        "segments": {
          "default": 96,
          "min": 8,
          "max": 256,
          "step": 1
        }
      },
      "rule": {
        "kind": "primitive",
        "template": "polygon_inline",
        "engine": "r_revolve",
        "_note": "INLINE polygon (same coordinates dp_spec_pin computes). Encoded as preamble + polygon expressions so the ProfileFnEditor renders the half-section + lets the user dial individual vertices. Math extracted from dp_spec_pin's pen API: .mv(ri,0).line(pr,0).line(pr,z1).line(jr,z2).line(jr,z3).line(pinR0,z3).line(noseR,z4).line(ri,z4). The COLLAR (jr-radius section, z2..z3) length is `barrel = jointLen - thdLen` — both inputs. Default jointLen=6, thdLen=4 → barrel=2 inches of collar.",
        "preamble": [
          "const D2R = Math.PI / 180;",
          "const ri = Math.max(0.05, pipeOD / 2 - wall);",
          "const pr = pipeOD / 2;",
          "const jr = jointOD / 2;",
          "const upsetRun = Math.max(0.05, (jr - pr) / Math.tan(jointTaper * D2R));",
          "const barrel = Math.max(0, jointLen - thdLen);",
          "const pinR0 = Math.max(ri + 0.05, jr - jtUpset);",
          "const noseR = Math.max(ri + 0.05, pinR0 - thdLen * Math.tan(threadTaper * D2R));",
          "const z1 = pipeLen;",
          "const z2 = z1 + upsetRun;",
          "const z3 = z2 + barrel;",
          "const z4 = z3 + thdLen;"
        ],
        "polygon": [
          "[ri, 0]",
          "[pr, 0]",
          "[pr, z1]",
          "[jr, z2]",
          "[jr, z3]",
          "[pinR0, z3]",
          "[noseR, z4]",
          "[ri, z4]"
        ],
        "derived_from_profile": "dp_spec_pin"
      },
      "exemplar": "dt_pin",
      "expects_bake": {
        "verts": 1344,
        "z_extent": 9.625,
        "outer_r": 2.625,
        "min_r": 1.5
      }
    },
    "box": {
      "kind": "rev",
      "definition": "Female complement of pin — counterbored receptacle; the female end of a tool joint mating with a pin.",
      "synonyms": [
        "female connection",
        "box-end",
        "drill-pipe box"
      ],
      "extends": "tube",
      "thread_spec": {
        "_note": "Metadata-only for v0.1 — geometry doesn't render threads yet (that needs r_threads overlay or similar, future work). Mates with pin of the same `name`.",
        "name": "NC50",
        "pitch": 0.25,
        "taper_in_per_ft": 2,
        "thread_starts": 1,
        "thread_form": "V"
      },
      "params": {
        "pipeOD": {
          "default": 4,
          "min": 0.5,
          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "jointOD": {
          "default": 5.25,
          "min": 0.5,
          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "wall": {
          "default": 0.5,
          "min": 0.05,
          "max": 5,
          "step": 0.05,
          "unit": "in"
        },
        "pipeLen": {
          "default": 3,
          "min": 0.1,
          "max": 50,
          "step": 0.1,
          "unit": "in"
        },
        "jointLen": {
          "default": 6,
          "min": 0.1,
          "max": 20,
          "step": 0.1,
          "unit": "in"
        },
        "jtUpset": {
          "default": 0.25,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "in"
        },
        "jointTaper": {
          "default": 45,
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "deg"
        },
        "segments": {
          "default": 96,
          "min": 8,
          "max": 256,
          "step": 1
        }
      },
      "rule": {
        "kind": "primitive",
        "template": "polygon_inline",
        "engine": "r_revolve",
        "_note": "INLINE polygon — same coordinates dp_spec_box computes. Editor renders + lets the user dial each vertex. Math from dp_spec_box's pen API: .mv(mouthR,0).line(jr,0).line(jr,jointLen).line(pr,jointLen+upsetRun).line(pr,zPipe).line(ri,zPipe).line(ri,zSeat).line(floorR,zSeat).line(floorR,zFloor).",
        "preamble": [
          "const D2R = Math.PI / 180;",
          "const ri = Math.max(0.05, pipeOD / 2 - wall);",
          "const pr = pipeOD / 2;",
          "const jr = jointOD / 2;",
          "const upsetRun = Math.max(0.05, (jr - pr) / Math.tan(jointTaper * D2R));",
          "const mouthR = Math.max(ri + 0.1, jr - jtUpset);",
          "const termR = ri + wall;",
          "const threadTaper = 5;",
          "const tt = Math.max(0.5, threadTaper) * D2R;",
          "const thdLen = Math.max(0.1, Math.min((mouthR - termR) / Math.tan(tt), jointLen - jtUpset - 0.1));",
          "const floorR = mouthR - thdLen * Math.tan(tt);",
          "const zFloor = thdLen;",
          "const zSeat = zFloor + jtUpset;",
          "const zPipe = jointLen + upsetRun + pipeLen;"
        ],
        "polygon": [
          "[mouthR, 0]",
          "[jr, 0]",
          "[jr, jointLen]",
          "[pr, jointLen + upsetRun]",
          "[pr, zPipe]",
          "[ri, zPipe]",
          "[ri, zSeat]",
          "[floorR, zSeat]",
          "[floorR, zFloor]"
        ],
        "derived_from_profile": "dp_spec_box"
      },
      "exemplar": "dt_box",
      "expects_bake": {
        "verts": null,
        "_note": "to populate after first translator pass + bake validation"
      }
    },
    "joint": {
      "kind": "asm",
      "definition": "A box + tube body + pin stacked end-to-end via tail() datums. The unit drill-pipe joint.",
      "synonyms": [
        "tool joint",
        "pipe joint",
        "drill-pipe joint",
        "single"
      ],
      "params": {
        "od": {
          "default": 4.5,
          "min": 0.5,
          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "wall": {
          "default": 0.5,
          "min": 0.05,
          "max": 5,
          "step": 0.05,
          "unit": "in"
        },
        "body_len": {
          "default": 30,
          "min": 1,
          "max": 120,
          "step": 0.5,
          "unit": "ft"
        }
      },
      "param_lifting": "hidden",
      "param_lifting_note": "Box / Pin's deep params (pipeOD, jointOD, jtUpset, jointTaper, threadTaper, …) stay as STATIC defaults inside the rule — NOT lifted to joint.params. Joint exposes only {od, wall, body_len}. Deep-dial overrides go through editing the joint's rule, not through assembly-level params.",
      "rule": {
        "kind": "compose",
        "imports": [
          {
            "alias": "A",
            "term": "box"
          },
          {
            "alias": "B",
            "term": "tube"
          },
          {
            "alias": "C",
            "term": "pin"
          }
        ],
        "composition": {
          "type": "stack",
          "_note": "Sequential end-to-end stack — handles tail() at runtime via manifold-helpers.stack().",
          "children": [
            {
              "type": "call",
              "fn": "A",
              "args": {}
            },
            {
              "type": "call",
              "fn": "B",
              "args": {
                "od": "p.od",
                "wall": "p.wall",
                "length": "p.body_len"
              }
            },
            {
              "type": "call",
              "fn": "C",
              "args": {}
            }
          ]
        }
      },
      "exemplar": "dt_joint",
      "expects_bake": {
        "verts": null,
        "_note": "to populate after first translator pass + bake validation"
      }
    },

          "max": 24,
          "step": 0.05,
          "unit": "in"
        },
        "wall": {
          "default": 0.5,
          "min": 0.05,
          "max": 5,
          "step": 0.05,
          "unit": "in"
        },
        "body_len": {
          "default": 30,
          "min": 1,
          "max": 120,
          "step": 0.5,
          "unit": "ft"
        }
      },
      "param_lifting": "hidden",
      "param_lifting_note": "Box / Pin's deep params (pipeOD, jointOD, jtUpset, jointTaper, threadTaper, …) stay as STATIC defaults inside the rule — NOT lifted to joint.params. Joint exposes only {od, wall, body_len}. Deep-dial overrides go through editing the joint's rule, not through assembly-level params.",
      "rule": {
        "kind": "compose",
        "imports": [
          {
            "alias": "A",
            "term": "box"
          },
          {
            "alias": "B",
            "term": "tube"
          },
          {
            "alias": "C",
            "term": "pin"
          }
        ],
        "composition": {
          "type": "stack",
          "_note": "Sequential end-to-end stack — handles tail() at runtime via manifold-helpers.stack().",
          "children": [
            {
              "type": "call",
              "fn": "A",
              "args": {}
            },
            {
              "type": "call",
              "fn": "B",
              "args": {
                "od": "p.od",
                "wall": "p.wall",
                "length": "p.body_len"
              }
            },
            {
              "type": "call",
              "fn": "C",
              "args": {}
            }
          ]
        }
      },
      "exemplar": "g_dp_joint",
      "expects_bake": {
        "verts": 47712,
        "z_extent": 37.5,
        "outer_r": 3,
        "min_r": 1.65,
        "_note": "g_dp_joint @ its meta.params defaults (body_len=25)."
      }
    },
